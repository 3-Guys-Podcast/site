---
// Page-level controls for the sitewide mini player (MiniPlayer.astro, in the
// layout). This component owns no <audio>; every button talks to window.TGB.
// Contract: data-episode JSON on the wrapper, data-page-play on the play
// button, data-seek on chapter rows, data-rate on speed buttons.
const { episode } = Astro.props;
const { audio, chapters, duration, seconds, guid, title, slug } = episode;
const data = JSON.stringify({
  key: guid,
  src: audio,
  title,
  href: '/episodes/' + slug + '/',
  seconds,
  chapters: chapters.map((c) => ({ start: c.start, title: c.title })),
});
---
<div class="player" data-episode={data}>
  <div class="resume" data-resume hidden>
    <span class="mark"></span>
    <span class="resume-text">You left off partway through this one.</span>
    <button class="btn btn-primary" type="button" data-resume-go>Resume</button>
    <button class="btn btn-ghost" type="button" data-resume-dismiss>Dismiss</button>
  </div>

  <div class="player-row">
    <button class="btn btn-primary btn-icon play" type="button" data-page-play={guid} data-episode={data} data-state="paused" aria-label={'Play ' + title}>
      <svg width="13" height="13" viewBox="0 0 12 12" aria-hidden="true" data-icon-play><polygon points="2,0.5 11,6 2,11.5" fill="currentColor"></polygon></svg>
      <svg width="13" height="13" viewBox="0 0 12 12" aria-hidden="true" data-icon-pause><rect x="2" y="1" width="3" height="10" fill="currentColor"></rect><rect x="7" y="1" width="3" height="10" fill="currentColor"></rect></svg>
    </button>
    <span class="player-meta muted">{duration}</span>
    <div class="rates">
      <button class="btn btn-ghost rate is-current" type="button" data-rate="1">1×</button>
      <button class="btn btn-ghost rate" type="button" data-rate="1.25">1.25×</button>
      <button class="btn btn-ghost rate" type="button" data-rate="1.5">1.5×</button>
    </div>
  </div>

  {chapters.length > 0 && (
    <div class="section-head tight">
      <h6>What we covered</h6><span class="rule"></span>
      <span class="muted tiny">Times are links</span>
    </div>
  )}

  {chapters.length > 0 && (
    <ol class="chapters" data-chapters>
      {chapters.map((c) => (
        <li>
          <button type="button" data-seek={c.start}>
            <span class="dot"></span>
            <span class="t">{c.label}</span>
            <span class="c">{c.title}</span>
          </button>
        </li>
      ))}
    </ol>
  )}
</div>
